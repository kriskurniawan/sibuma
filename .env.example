# ── Aplikasi ─────────────────────────────────────────────────────────────────
# Wajib di production: minimal 32 karakter acak. Aplikasi menolak berjalan bila
# kosong, terlalu pendek, atau masih memakai nilai pengembangan.
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
NEXT_PUBLIC_APP_TIMEZONE=Asia/Jakarta
# Hanya true eksplisit mengaktifkan demo (OTP di layar, tanpa mengirim pesan OTP).
# Wajib false di production.
DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Neon Postgres ────────────────────────────────────────────────────────────
# Connection string dari Neon Console → Connect. Gunakan pooled connection
# untuk deployment serverless/Vercel.
DATABASE_URL=

# ── Neon Object Storage (S3-compatible) ──────────────────────────────────────
# Ambil dari Neon Console → Connect → Storage, atau `neon env pull`.
# Bucket harus privat dan khusus untuk dokumentasi. `npm run storage:init`
# memasang Public Access Block agar objek tidak dapat dibaca anonim.
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET=documentation

# ── Chatery (WhatsApp) ───────────────────────────────────────────────────────
# Untuk OTP produksi: WA gagal/tidak dikonfigurasi akan fallback ke Resend.
# Notifikasi SPKL belum memiliki fallback email (tanpa konfigurasi: outbox demo).
CHATERY_API_URL=
CHATERY_API_KEY=
CHATERY_SESSION_ID=

# ── Resend (OTP email / fallback WhatsApp) ───────────────────────────────────
# Buat API key dengan izin kirim dan verifikasi domain di Resend.
# Sender harus berasal dari domain terverifikasi; jangan pakai email pekerja.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
